# Sweet Spoon by Hetty — Environment Variables
# Copy this to .env.local and fill in your real values
# NEVER commit .env.local to Git

# ============================================================
# DATABASE (Supabase PostgreSQL via Prisma)
# ============================================================
# Get from: Supabase → Settings → Database → Connection string (Transaction mode)
DATABASE_URL="postgresql://postgres.[your-project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Get from: Supabase → Settings → Database → Connection string (Session mode)  
DIRECT_URL="postgresql://postgres.[your-project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ============================================================
# NEXT AUTH (Authentication)
# ============================================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-random-secret-here-minimum-32-characters"
NEXTAUTH_URL="http://localhost:3000"

# ============================================================
# PAYSTACK (Payment Gateway)
# ============================================================
# Get from: https://dashboard.paystack.com → Settings → API Keys
# Use test keys for development, live keys for production
PAYSTACK_SECRET_KEY="sk_test_your_paystack_secret_key"
PAYSTACK_WEBHOOK_SECRET="your-paystack-webhook-secret"

# These are safe to expose in frontend
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_your_paystack_public_key"

# ============================================================
# SUPABASE (Storage & Direct DB Access)
# ============================================================
# Get from: Supabase → Settings → API
SUPABASE_URL="https://[your-project-ref].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Public (safe to expose in frontend)
NEXT_PUBLIC_SUPABASE_URL="https://[your-project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ============================================================
# SITE CONFIGURATION
# ============================================================
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Sweet Spoon by Hetty"

# ============================================================
# OWNER ACCOUNT (Initial Bootstrap - CHANGE AFTER FIRST LOGIN)
# ============================================================
# These are used only during database seeding
OWNER_EMAIL="BigDebbie@sweetspoonbyhetty.com"
OWNER_USERNAME="BigDebbie"
# The actual password is set in the seed file as a hashed value
# Initial temp password is: Debbie12345 (owner must change on first login)

# ============================================================
# EMAIL NOTIFICATIONS (Optional - configure if needed)
# ============================================================
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-app-password"
# SMTP_FROM="Sweet Spoon by Hetty <noreply@sweetspoonbyhetty.com>"
